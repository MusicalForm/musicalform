/* LCMA Form Annotation Standard v0.1 */

Label               ::= (Name ':')? ~ (FormLabel|PlaceholderLabel) (~ '-' ~ FormLabel)*

FormLabel           ::= Form ~ MaterialBrackets? ~ Combinator?
PlaceholderLabel    ::= Placeholder Shorthand? ~ MaterialBrackets?
Placeholder         ::= "%"

Name                ::= [a-zA-Z0-9'_]+

Form                ::= FunctionLabel ('|' TypeExp)? Certainty?
Certainty           ::= '?'

FunctionLabel       ::= FunctionExpr (~ Combinator ~ FunctionExpr)?
Combinator          ::= '/' | '>'

FunctionExpr         ::= Function Shorthand?

Function            ::= '"' FunctionName '"'
                      | FunctionName

FunctionName        ::= SpecificFunction | GenericFunction

GenericFunction     ::= (Cardinality "_"?)? ~ Unit

/* 0th to 99th: teens always take 'th'; otherwise the last digit determines the suffix */
Cardinality         ::= /(?:1[0-9]th|[2-9]?(?:1st|2nd|3rd|[04-9]th))/

Unit                ::= 'unit' | 'x' | 'part' | 'section' | 'sec' | 'phrase' | 'sub-phrase' | 'idea'
                      | 'work' | 'movement' | 'mvt' | 'piece' | 'zone' | 'theme'
                      | 'album' | 'song' | 'cycle' | 'group'

SpecificFunction    ::= 'antecedent' | 'ant'
                      | 'after-the-end' | 'ate'
                      | 'basic_idea' | 'bi'
                      | 'beginning' | 'beg'
                      | 'cadential_idea' | 'cadi'
                      | 'cadential_phrase' | 'cad'
                      | 'compound_basic_idea' | 'cbi'
                      | 'codetta' | 'cdta'
                      | 'contrasting_idea' | 'ci'
                      | 'contrasting_middle' | 'cm'
                      | 'closing_theme' | 'cls'
                      | 'coda'
                      | 'consequent' | 'cons'
                      | 'continuation_idea' | 'continuation' | 'conti' | 'cont'
                      | 'development_section' | 'dev'
                      | 'end'
                      | 'essential_expositional_closure' | 'eec'
                      | 'essential_sonata_closure' | 'esc'
                      | 'exposition' | 'exp'
                      | 'fragmentation' | 'frag'
                      | 'introduction' | 'intro'
                      | 'lead-in' | 'lin'
                      | 'middle' | 'mid'
                      | 'model' | 'mod'
                      | 'postcadential' | 'pcad'
                      | 'presentation' | 'pres'
                      | 'primary_theme_zone' | 'primary_theme' | 'ptz' | 'pt'
                      | 'recapitulation' | 'recap'
                      | 'ritornello' | 'rit'
                      | 'retransition' | 'rtr'
                      | 'secondary_theme_zone' | 'secondary_theme' | 'stz' | 'st'
                      | 'sequence' | 'seq'
                      | 'transition' | 'tr'



TypeExp             ::= '"' FormalType '"'
                      | FormalType

FormalType          ::= 'hybrid1' | 'hyb1'
                      | 'hybrid2' | 'hyb2'
                      | 'hybrid3' | 'hyb3'
                      | 'hybrid4' | 'hyb4'
                      | 'model_sequence' | 'modseq'
                      | 'period' | 'pd'
                      | 'repeated' '_'? ~ Unit
                      | 'ritornello_form' | 'ritornello'
                      | 'rondo_form' | 'rondo'
                      | 'sentence' | 'sent'
                      | 'sequence' | 'seq'
                      | 'sonata_form' | 'sonata'
                      | 'unary_form' | 'unary'
                      | 'simple_binary.balanced' | 'simple_binary'
                      | 'rounded_binary'
                      | 'ternary.through_composed' | 'ternary.da_capo' | 'ternary'



MaterialBrackets    ::= '[' MaterialPositions ']'

MaterialPositions   ::= TargetOnly
                      | MaterialRef ',' MaterialRef
                      | SourceOnly
                      | MaterialRef
/* This is the highest level designating the "Material Brackets" as we call them.
 * If FunctionLabel takes the form (FunctionExpr Combinator FunctionExpr), then there
 * are three possibilities:
 * 1) One MaterialRef followed by a comma to be attributed to the first FunctionExpr
 * 2) One MaterialRef preceded by a comma to be attributed to the second FunctionExpr
 * 3a) A single MaterialRef describing the entire segment
 * 3b) The case where the single MaterialRef is a concatenation: then it needs to be
 *     wrapped in brackets, resulting in double MaterialBrackets: [[Concatenation]]
 */

TargetOnly          ::= ',' MaterialRef
SourceOnly          ::= MaterialRef ','

MaterialRef         ::= '[' Concatenation ']'
                      | '(' Concatenation ')'
                      | Concatenation
                      | Entry

Concatenation       ::= Entry (',' Entry)+

Shorthand           ::= MaterialRelations
MaterialKeyword     ::= "$" ("adapt" | "aug" | "comb" | "conc" | "dim" | "ext" | "inv" | "orn" | "part" | "rep" | "retr" | "transp" | "var")
MaterialOperator    ::= [!*~^°+]
MaterialRelations   ::= (MaterialKeyword | MaterialOperator)+
Entry               ::= ('"' Name '"' | Name) MaterialRelations?
